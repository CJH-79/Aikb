# 复制为 .env 或在启动前 export，不要把真实的 Key 提交到仓库

# ---------- 数据库 ----------
KB_DB_USER=root
KB_DB_PASSWORD=your-password

# ---------- 对话模型 ----------
# 不启用时是纯检索模式，其余功能不受影响
KB_AI_ENABLED=false
OPENAI_API_KEY=sk-not-configured

# 走 OpenAI 兼容协议，换服务商只改这几行
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
# DeepSeek 示例：
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat

# ---------- 向量模型（混合检索） ----------
# 关闭时检索走纯 BM25，功能照常可用
KB_EMBEDDING_ENABLED=false
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# 各家示例（base-url 与对话模型共用同一个变量）：
# 阿里百炼   OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode
#            OPENAI_EMBEDDING_MODEL=text-embedding-v3
# 智谱       OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#            OPENAI_EMBEDDING_MODEL=embedding-3
# 硅基流动   OPENAI_BASE_URL=https://api.siliconflow.cn
#            OPENAI_EMBEDDING_MODEL=BAAI/bge-m3
# 本地 Ollama OPENAI_BASE_URL=http://localhost:11434/v1
#            OPENAI_EMBEDDING_MODEL=nomic-embed-text

# ---------- 检索调参 ----------
# 向量余弦阈值必须按模型校准：
#   bge 系列无关文本也有 0.4~0.5 → 设 0.55 左右
#   OpenAI text-embedding-3 无关文本 0.1~0.3 → 设 0.3~0.35
# 发现无关切片被向量顶到第一时，把 vector-weight 降到 0.3
# KB_SEARCH_VECTORMINSIMILARITY=0.55
# KB_SEARCH_VECTORWEIGHT=1.0

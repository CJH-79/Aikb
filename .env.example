# 复制为 .env 或在启动前 export，不要把真实的 Key 提交到仓库

# 数据库
KB_DB_USER=root
KB_DB_PASSWORD=123456

# 是否启用模型问答。不启用时是纯检索模式，其余功能不受影响
KB_AI_ENABLED=false
OPENAI_API_KEY=sk-not-configured

# 走 OpenAI 兼容协议，换服务商只改这三行
OPENAI_BASE_URL=https://api.openai.com
OPENAI_MODEL=gpt-4o-mini
# DeepSeek 示例：
# OPENAI_BASE_URL=https://api.deepseek.com
# OPENAI_MODEL=deepseek-chat
